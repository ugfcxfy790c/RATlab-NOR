# Python
__pycache__/
*.pyc

# OS cruft
.DS_Store

# Runtime data and caches -- generated by running the app, not part of
# the app itself. Includes real research data (clicked object
# coordinates, job queue, cached SLEAP predictions) that's specific to
# whoever's running this, not something to publish.
app_data/
input/
output/
predictions/
object_coords.json

# Packaging build output (see packaging/README.md) -- regenerated by
# build_mac.sh / build_windows.bat / build_linux.sh, not tracked.
packaging/.venv/
packaging/build/
packaging/dist/
